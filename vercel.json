{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "{index.html,matching_statement.py,pdf_layout.py}"
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/api" },
    { "source": "/reconcile", "destination": "/api" }
  ]
}
